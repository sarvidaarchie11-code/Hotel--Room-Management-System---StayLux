# Copy this file to ".env" and edit the values.
PORT=4000
DATABASE_URL="file:./dev.db"

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Initial administrator (created ONLY by `npm run db:seed`).
# The admin is forced to change this password on first login.
ADMIN_EMAIL=admin@hotel.local
ADMIN_FULL_NAME=Hotel Administrator
ADMIN_PASSWORD="ChangeMe#2026"

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
